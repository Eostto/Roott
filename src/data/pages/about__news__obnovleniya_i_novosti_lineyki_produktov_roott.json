mg/copy-icon.svg\" alt=\"copy\">\n\t\t\t\t\t\t\t\t</a>\n<div class=\"yandex-share-panel ar_al_left\">\n\t\t<div class=\"ya-share-wrap\"><div class=\"ya-share2\" data-services=\"telegram,whatsapp,vkontakte\" data-more-button-type=\"short\" data-limit=\"0\" data-color-scheme=\"whiteblack\" data-size=\"m\"></div></div>\n</div>\n<style>\n\t.ya-share2__item_more.ya-share2__item_has-pretty-view .ya-share2__icon_more{\n\t\tbackground-image: url('/images/roott/tpl/assets/img/send-icon.svg');\n\t}\n\t.ya-share2__container_size_m .ya-share2__item_copy .ya-share2__icon_copy, .ya-share2__container_size_m .ya-share2__item_more .ya-share2__icon_more{\n\t\tbackground-size: 18px 18px;\n\t\twidth: 18px;\n\t\theight: 18px;\n\t}\n\t.ya-share2__container_size_m .ya-share2__item_more.ya-share2__item_has-pretty-view .ya-share2__link_more.ya-share2__link_more-button-type_short{\n\t\tpadding: 0;\n\t\tbackground: none;\n\t}\n\t.ya-share2__list.ya-share2__list_direction_vertical{\n\t\tdisplay: grid !important;\n\t}\n\t.ya-share2__container_size_m.ya-share2__container_alone .ya-share2__popup_direction_bottom, .ya-share2__container_size_m .ya-share2__item_more.ya-share2__item_has-pretty-view .ya-share2__popup_direction_bottom{\n\t\tright: -72px;\n\t}\n</style>\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"news_fist_img\">\n\t\t\t\t\t\t\t<img src=\"/images/roott/upload/iblock/3ef/xd3ik8qqi8dx6gmuiu0fdnnlu38mds1z.jpg\" fetchpriority=\"high\" alt=\"Обновления и новости линейки продуктов ROOTT\" width=\"1200\" height=\"800\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"keys_detail__txt__p\">Стоматологическая отрасль постоянно развивается, и мы в ROOTT гордимся тем, что остаемся на шаг впереди. Наша команда исследователей и разработчиков постоянно работает над выявлением новых тенденций и технологий в отрасли и разработкой инновационных решений, отвечающих растущим потребностям стоматологов.<br>\n <br>\n Поскольку отрасль приближается к цифровым процессам, мы осознаем важность оставаться в авангарде этих разработок. Вот почему мы рады объявить о последних обновлениях и новостях нашей линейки продуктов, призванных помочь стоматологам воспользоваться преимуществами новейших цифровых технологий. Кроме того, мы понимаем, что специалисты-стоматологи ищут новые и свежие перспективы для улучшения результатов операций, и мы стремимся предоставить им инструменты и решения, необходимые для достижения этой цели. Итак, ищете ли вы инструменты для повышения точности и точности установки имплантатов или аксессуары, которые помогут вам воспользоваться преимуществами новейших цифровых технологий, ROOTT поможет вам.<br>\n<h2>Имплантовод ITHEH</h2>\n Самым значительным из этих обновлений является внедрение имплантовода ITHEH для наконечника, специально разработанного для установки имплантатов ROOTT M и ROOTT P через новые держатели PHFCM и HFCM соответственно. Этот новый имплантовод подходит для хирургии по шаблонам и поставляется в трех различных размерах, каждый из которых имеет уникальные размеры. Этот диапазон размеров позволяет стоматологам выбрать наиболее подходящий вариант для их конкретных потребностей и предпочтений:<br>\n<ul>\n\t<li>Имплантовод ITHEHS имеет общую длину 20,45 мм и рабочую часть 15,10 мм.</li>\n\t<li>Имплантовод ITHEH имеет общую длину 28,95 мм и рабочую часть 23,60 мм.</li>\n\t<li>С другой стороны, имплантовод ITHEHL имеет общую длину 48,95 мм и рабочую часть 43,60 мм.</li>\n</ul>\n <br>\n Одним из наиболее значительных преимуществ нового имплантовода ITHEH является его совместимость с держателями PHFCM и HFCM. Держатель PHFCM специально разработан для имплантатов ROOTT M и идеально подходит для сканирования и хирургии по шаблонам. Новый держатель заменяет старый металлический держатель HFCM, использование которого в цифровом рабочем процессе было ограничено.<br>\n <br>\n Благодаря уникальному пластиковому держателю стоматологи теперь могут воспользоваться новейшими цифровыми технологиями для обеспечения более точного и эффективного лечения своих пациентов.<br>\n<h2>SFPCOM теперь прибывает с ROOTT P/M</h2>\n <br>\n &nbsp;Еще одним интересным обновлением линейки продуктов ROOTT является появление винта SFPCOM для комплекта упаковки имплантатов ROOTT P и ROOTT M. Этот винт теперь входит в комплект каждого имплантата ROOTT P и ROOTT M и предназначен для работы с различными цифровыми библиотеками, что устраняет необходимость приобретать их отдельно. Винт SFPCOM — это широкий и прочный винт, который идеально подходит для использования с абатментами серии M и цифровыми решениями.<br>\n <br>\nВ целом, эти обновления линейки продуктов ROOTT представляют собой значительный прогресс; Представляя новые и улучшенные инструменты и аксессуары, ROOTT упрощает, чем когда-либо, для стоматологов предоставление наилучшего ухода за своими пациентами. Используя хирургические инструкции, технологии сканирования или цифровые библиотеки, стоматологи теперь могут воспользоваться преимуществами новейших технологий для обеспечения более точного и эффективного лечения своих пациентов. Кроме того, теперь они могут положиться на ROOTT, который предоставит им наилучшие инструменты и аксессуары, которые помогут им достичь наилучших результатов.</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"keys_detail__photos\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"keys_detail__author__block\">\n\t\t\t\t\t\t\t<h6 class=\"keys_detail__author__block__title\">Автор</h6>\n\t\t\t\t\t\t\t<div class=\"keys_detail__author__block__wrap\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img src=\"/images/roott/upload/iblock/e67/0owh7gomo2pa0p4zus0i87l34xp3s143.png\" loading=\"lazy\" decoding=\"async\" alt=\"ROOTT\" width=\"560\" height=\"560\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"keys_detail__author__block__wrap__txt\">\n\t\t\t\t\t\t\t\t\t<span class=\"keys_de